# SceneViewer environment configuration
# Copy this file to .env and edit the values.

# Path to an existing HSSD models checkout (containing objects/, stages/, support-surfaces/).
# This avoids re-downloading HSSD assets when building HSM previews.
# Can also be set in config.yml or as a real environment variable.
# SCENEVIEWER_HSSD_ROOT=/home/user/proj/scenesmith/data/hssd-models
